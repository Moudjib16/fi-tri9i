<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Mes trajets' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="site-main">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">Mon espace</p>
        <h1>Mes trajets</h1>
        <p>Retrouvez les trajets que vous publiez et vos réservations.</p>
      </div>
      <a class="btn" href="/publier/page1">Publier un trajet</a>
    </header>

    <% const draftTrips = typeof drafts !== 'undefined' ? drafts : []; %>
    <% const cancelledList = typeof cancelledTrips !== 'undefined' ? cancelledTrips : []; %>
    <% const bookedList = typeof booked !== 'undefined' ? booked : []; %>

    <section class="dashboard-stats" aria-label="Résumé de votre activité">
      <div class="stat-card">
        <strong><%= published.length %></strong>
        <span>trajet<%= published.length === 1 ? '' : 's' %> publié<%= published.length === 1 ? '' : 's' %></span>
      </div>
      <div class="stat-card">
        <strong><%= bookedList.length %></strong>
        <span>réservation<%= bookedList.length === 1 ? '' : 's' %></span>
      </div>
      <div class="stat-card">
        <strong><%= draftTrips.length %></strong>
        <span>brouillon<%= draftTrips.length === 1 ? '' : 's' %></span>
      </div>
      <div class="stat-card">
        <strong><%= cancelledList.length %></strong>
        <span>trajet<%= cancelledList.length === 1 ? '' : 's' %> annulé<%= cancelledList.length === 1 ? '' : 's' %></span>
      </div>
    </section>

    <% if (draftTrips.length) { %>
      <section class="my-section">
        <div class="results-head">
          <h2>Brouillons (<%= draftTrips.length %>)</h2>
        </div>

        <div class="trip-grid">
          <% draftTrips.forEach(function (t) { %>
            <article class="trip-card draft-card">
              <span class="draft-badge">Brouillon privé</span>
              <div class="trip-route">
                <span><%= t.depart || 'Départ à définir' %></span>
                <span class="route-arrow">&rarr;</span>
                <span><%= t.arrivee || 'Destination à définir' %></span>
              </div>

              <dl class="trip-meta">
                <div>
                  <dt>Date</dt>
                  <dd><%= t.dateData || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Heure</dt>
                  <dd><%= t.time || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Prix</dt>
                  <dd><%= t.price || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Places</dt>
                  <dd><%= t.places || 1 %></dd>
                </div>
              </dl>

              <div class="trip-card-footer">
                <form action="/trajets/<%= t._id %>/supprimer" method="post" data-confirm="Supprimer ce brouillon ?">
                  <%- include('./partials/csrf-input.ejs') %>
                  <button type="submit" class="cancel-link">Supprimer</button>
                </form>
                <a class="trip-link" href="/publier/continuer/<%= t._id %>">Reprendre &rarr;</a>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <section class="my-section">
      <div class="results-head">
        <h2>Trajets publiés (<%= published.length %>)</h2>
      </div>

      <% if (!published.length) { %>
        <div class="empty-state">
          <h3>Vous n'avez publié aucun trajet.</h3>
          <p>Publiez votre premier trajet pour partager vos places.</p>
          <a class="btn" href="/publier/page1">Publier un trajet</a>
        </div>
      <% } else { %>
        <div class="trip-grid">
          <% published.forEach(function (t) { %>
            <% const remaining = Math.max((t.places || 0) - (t.places_taken || 0), 0); %>
            <% const passengers = t.passengers || []; %>
            <% const passengerNames = passengers.filter(function (p) { return p && p.name; }).map(function (p) { return p.name; }); %>
            <article class="trip-card">
              <div class="trip-route">
                <span><%= t.depart %></span>
                <span class="route-arrow">&rarr;</span>
                <span><%= t.arrivee || 'Destination à préciser' %></span>
              </div>

              <dl class="trip-meta">
                <div>
                  <dt>Date</dt>
                  <dd><%= t.dateData || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Heure</dt>
                  <dd><%= t.time || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Prix</dt>
                  <dd><%= t.price || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Places</dt>
                  <dd><%= remaining %> / <%= t.places %></dd>
                </div>
              </dl>

              <p class="my-count">
                Réservations : <strong><%= passengerNames.length %></strong>
                <% if (passengerNames.length) { %>
                  &middot; <%= passengerNames.join(', ') %>
                <% } %>
              </p>

              <div class="trip-card-footer">
                <span class="pill"><%= remaining %> place<%= remaining === 1 ? '' : 's' %> libre<%= remaining === 1 ? '' : 's' %></span>
                <a class="trip-link" href="/trajets/<%= t._id %>">Voir le trajet &rarr;</a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <% if (cancelledList.length) { %>
      <section class="my-section">
        <div class="results-head">
          <h2>Trajets annulés (<%= cancelledList.length %>)</h2>
        </div>

        <div class="trip-grid">
          <% cancelledList.forEach(function (t) { %>
            <article class="trip-card cancelled-card">
              <span class="draft-badge cancelled-badge">Annulé</span>
              <div class="trip-route">
                <span><%= t.depart %></span>
                <span class="route-arrow">&rarr;</span>
                <span><%= t.arrivee || 'Destination à préciser' %></span>
              </div>

              <dl class="trip-meta">
                <div>
                  <dt>Date</dt>
                  <dd><%= t.dateData || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Heure</dt>
                  <dd><%= t.time || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Prix</dt>
                  <dd><%= t.price || 'À préciser' %></dd>
                </div>
              </dl>

              <div class="trip-card-footer">
                <span></span>
                <a class="trip-link" href="/trajets/<%= t._id %>">Voir le trajet &rarr;</a>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <section class="my-section" id="reservations">
      <div class="results-head">
        <h2>Mes réservations (<%= bookedList.length %>)</h2>
      </div>

      <% if (!bookedList.length) { %>
        <div class="empty-state">
          <h3>Vous n'avez aucune réservation.</h3>
          <p>Parcourez les trajets disponibles et réservez votre place.</p>
          <a class="btn" href="/trajets">Rechercher un trajet</a>
        </div>
      <% } else { %>
        <div class="trip-grid">
          <% bookedList.forEach(function (t) { %>
            <% const tripPast = Boolean(t.departureAt && new Date(t.departureAt) <= new Date()); %>
            <% const bookedDriver = t.driver && t.driver.name ? t.driver.name : 'Anonyme'; %>
            <article class="trip-card<%= t.status === 'cancelled' ? ' cancelled-card' : '' %>">
              <% if (t.status === 'cancelled') { %>
                <span class="draft-badge cancelled-badge">Annulé par le conducteur</span>
              <% } else if (tripPast) { %>
                <span class="draft-badge">Trajet passé</span>
              <% } %>
              <div class="trip-route">
                <span><%= t.depart %></span>
                <span class="route-arrow">&rarr;</span>
                <span><%= t.arrivee || 'Destination à préciser' %></span>
              </div>

              <dl class="trip-meta">
                <div>
                  <dt>Date</dt>
                  <dd><%= t.dateData || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Heure</dt>
                  <dd><%= t.time || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Prix</dt>
                  <dd><%= t.price || 'À préciser' %></dd>
                </div>
                <div>
                  <dt>Conducteur</dt>
                  <dd><%= bookedDriver %></dd>
                </div>
              </dl>

              <div class="trip-card-footer">
                <% if (t.status !== 'cancelled' && !tripPast) { %>
                  <form action="/trajets/<%= t._id %>/annuler" method="post">
                    <%- include('./partials/csrf-input.ejs') %>
                    <button type="submit" class="cancel-link">Annuler</button>
                  </form>
                <% } else { %>
                  <span></span>
                <% } %>
                <a class="trip-link" href="/trajets/<%= t._id %>">Voir le trajet &rarr;</a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('./partials/footer.ejs') %>
  <script src="/shared/navbar.js"></script>
</body>
</html>
