<!DOCTYPE html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fi Tri9i | Inscription</title>
    <link rel="stylesheet" href="/shared/navbar.css">
    <link rel="stylesheet" href="/signup/style.css">
    <link rel="stylesheet" href="/shared/auth.css">
  </head>
<body>
  <%- include('./partials/navbar.ejs') %>

  <div class="wrapper">
    <h2>Inscription</h2>
    <form action="/signup" method="post">
      <div class="input-box">
        <input type="text" name="name" placeholder="Votre nom" autocomplete="name" required>
      </div>
      <div class="input-box">
        <input type="email" name="email" placeholder="Votre email" autocomplete="email" required>
      </div>
      <%= exist %>
      <div class="input-box">
        <input type="password" name="password" placeholder="Créer un mot de passe" autocomplete="new-password" minlength="6" required>
      </div>
      <div class="input-box">
        <input type="password" name="confirm-password" placeholder="Confirmer le mot de passe" autocomplete="new-password" minlength="6" required>
      </div>
      <div class="input-box">
        <label for="userType">Je suis :</label>
        <select id="userType" name="userType" required>
          <option value="1">Passager</option>
          <option value="2">Conducteur</option>
        </select>
      </div>
      <div class="policy">
        <input type="checkbox" name="terms" id="terms" required>
        <label for="terms"><h3>J'accepte les conditions d'utilisation</h3></label>
      </div>
      <div class="input-box button">
        <input type="submit" value="S'inscrire">
      </div>
      <div class="text">
        <h3>Déjà un compte ? <a href="/login">Se connecter</a></h3>
      </div>
    </form>
  </div>

  <script src="/shared/navbar.js"></script>
</body>
</html>
