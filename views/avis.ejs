<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Laisser un avis' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="wizard-shell review-page">
    <a class="back-link" href="/trajets/<%= trip._id %>">&larr; Retour au trajet</a>

    <section class="wizard-card">
      <p class="eyebrow">Avis</p>
      <h1 class="wizard-title">Comment s'est passé votre trajet ?</h1>
      <p class="wizard-help">
        <%= trip.depart %> &rarr; <%= trip.arrivee || 'Destination à préciser' %>
        &middot; <%= trip.dateData || 'Date à préciser' %> &middot; avec <%= driverName %>
      </p>

      <% if (error) { %>
        <p class="form-error" role="alert"><%= error %></p>
      <% } %>

      <form class="wizard-form" action="/trajets/<%= trip._id %>/avis" method="post">
        <%- include('./partials/csrf-input.ejs') %>

        <label class="field">
          <span>Votre note</span>
          <select name="rating" required>
            <option value=""<%= values.rating === '' ? ' selected' : '' %>>Choisir une note</option>
            <option value="5"<%= values.rating === '5' ? ' selected' : '' %>>5 — Excellent</option>
            <option value="4"<%= values.rating === '4' ? ' selected' : '' %>>4 — Très bien</option>
            <option value="3"<%= values.rating === '3' ? ' selected' : '' %>>3 — Bien</option>
            <option value="2"<%= values.rating === '2' ? ' selected' : '' %>>2 — Moyen</option>
            <option value="1"<%= values.rating === '1' ? ' selected' : '' %>>1 — Décevant</option>
          </select>
        </label>

        <label class="field">
          <span>Votre commentaire (facultatif)</span>
          <textarea name="comment" maxlength="500" placeholder="Ponctualité, ambiance, conduite..."><%= values.comment %></textarea>
        </label>

        <p class="review-note">Votre avis sera public sur le profil du conducteur.</p>

        <div class="wizard-actions">
          <a class="btn ghost" href="/trajets/<%= trip._id %>">Annuler</a>
          <button class="btn" type="submit">Publier mon avis</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/shared/navbar.js" defer></script>
</body>
</html>
