<style>
  .navbar ul > li { display: flex; align-items: center; }
  .menu .logout-form { margin: 0; padding: 0; width: 100%; }
  .menu button.option { border: 0; padding: 0; font-family: inherit; }
  .menu-toggle { border: 0; padding: 0; background: transparent; cursor: pointer; display: flex; align-items: center; }
</style>

<nav class="navbar">
  <ul>
    <li>
      <a class="logo" href="/">
        <p>Fi Tri9i</p>
        <img src="/home/pics/car.svg" class="logo_img" alt="">
      </a>
    </li>

    <li>
      <a href="/trajets" class="pub">
        <img src="/home/pics/rech.svg" class="plus" alt="">
        <span class="Publiertrajet">Recherche</span>
      </a>
    </li>

    <li>
      <a href="/publier/page1" class="pub">
        <img src="/home/pics/plus.svg" class="plus" alt="">
        <span class="Publiertrajet">Publier trajet</span>
      </a>
    </li>

    <li class="auth">
      <p class="user-name" id="user-name"><%= currentUser ? currentUser.name : 'Invité' %></p>
      <img src="/home/pics/pfp.svg" class="pfp" alt="">
      <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
        <img src="/home/pics/arrow.svg" class="arrow" id="arrow" alt="">
      </button>
    </li>
  </ul>

  <div class="menu" id="menu">
    <% if (currentUser) { %>
      <a class="option" href="/mes-trajets">
        <img src="/home/pics/menu-icons/trajet.png" class="icon">
        <p class="text">Mes trajets</p>
        <p class="cotation">&gt;</p>
      </a>
      <div class="line"></div>
      <a class="option" href="/publier/page1">
        <img src="/home/pics/menu-icons/trajet.png" class="icon">
        <p class="text">Publier un trajet</p>
        <p class="cotation">&gt;</p>
      </a>
      <div class="line"></div>
      <form class="logout-form" action="/logout" method="post">
        <%- include('./csrf-input.ejs') %>
        <button type="submit" class="option">
          <img src="/home/pics/menu-icons/log-out.png" class="icon">
          <p class="text">Déconnexion</p>
          <p class="cotation">&gt;</p>
        </button>
      </form>
    <% } else { %>
      <a class="option" href="/login">
        <img src="/home/pics/menu-icons/log.png" class="icon">
        <p class="text">Connexion</p>
        <p class="cotation">&gt;</p>
      </a>
      <div class="line"></div>
      <a class="option" href="/signup">
        <img src="/home/pics/menu-icons/sign.png" class="icon">
        <p class="text">Inscription</p>
        <p class="cotation">&gt;</p>
      </a>
    <% } %>
  </div>
</nav>
