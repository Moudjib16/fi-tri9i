<% const signedIn = typeof currentUser !== 'undefined' && currentUser; %>
<% const unreadCount = typeof unreadNotifications !== 'undefined' ? unreadNotifications : 0; %>
<header class="site-header">
  <nav class="nav-shell" aria-label="Navigation principale">
    <a class="brand" href="/" aria-label="Fi Tri9i, accueil">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 19c6 0 3-8 9-8 2.2 0 3.4 1.2 5 1.8"></path>
          <circle cx="5" cy="19" r="2"></circle>
          <circle cx="19" cy="13" r="2"></circle>
        </svg>
      </span>
      <span class="brand-copy">
        <strong>Fi Tri9i</strong>
        <span>Covoiturage</span>
      </span>
    </a>

    <div class="nav-links" id="nav-links">
      <a class="nav-link" href="/trajets">Trouver un trajet</a>
      <a class="nav-link" href="/publier/page1">Publier</a>
      <a class="nav-link" href="/a-propos">À propos</a>
      <% if (signedIn) { %>
        <a class="nav-link" href="/mes-trajets">Mes trajets</a>
        <a class="nav-link nav-notifications" href="/notifications">
          Notifications
          <% if (unreadCount > 0) { %>
            <span class="nav-badge" aria-label="<%= unreadCount %> non lue<%= unreadCount === 1 ? '' : 's' %>"><%= unreadCount > 9 ? '9+' : unreadCount %></span>
          <% } %>
        </a>
      <% } %>
    </div>

    <div class="nav-actions">
      <% if (signedIn) { %>
        <a class="btn nav-cta" href="/publier/page1">Publier un trajet</a>
        <div class="profile">
          <button class="profile-button" type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu du compte">
            <span class="avatar" aria-hidden="true"><%= currentUser.name ? currentUser.name.trim().charAt(0) : '?' %></span>
            <span class="profile-name"><%= currentUser.name || 'Mon compte' %></span>
            <svg class="profile-arrow" id="arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 7 5 5 5-5"></path>
            </svg>
          </button>

          <div class="profile-panel" id="menu" hidden>
            <a href="/mes-trajets">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18V6a2 2 0 0 1 2-2h5l2 3h5a2 2 0 0 1 2 2v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z"></path></svg>
              Mes trajets
            </a>
            <a href="/notifications">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 21h4"></path></svg>
              Notifications<% if (unreadCount > 0) { %> <span class="nav-badge"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %>
            </a>
            <a href="/publier/page1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              Publier un trajet
            </a>
            <a href="/compte">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
              Mon compte
            </a>
            <div class="panel-divider"></div>
            <form class="profile-form" action="/logout" method="post">
              <%- include('./csrf-input.ejs') %>
              <button type="submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3"></path><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"></path></svg>
                Déconnexion
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a class="nav-ghost" href="/login">Connexion</a>
        <a class="btn nav-cta" href="/signup">Inscription</a>
      <% } %>

      <button class="mobile-nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Ouvrir la navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
  <div class="flash <%= flash.error ? 'error' : 'success' %>" role="<%= flash.error ? 'alert' : 'status' %>">
    <%= flash.error || flash.success %>
  </div>
<% } %>
