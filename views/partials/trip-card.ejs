<% const remaining = Math.max((t.places || 0) - (t.places_taken || 0), 0); %>
<% const driverName = t.driver && t.driver.name ? t.driver.name : 'Anonyme'; %>
<% const driverId = t.driver && t.driver._id ? t.driver._id : null; %>
<% const driverRating = Number(t.driverRating) || 0; %>
<% const driverRatingCount = Number(t.driverRatingCount) || 0; %>
<% const distance = tripDistance(t); %>
<article class="trip-card">
  <div class="trip-route">
    <span><%= t.depart %></span>
    <span class="route-arrow">&rarr;</span>
    <span><%= t.arrivee || 'Destination à préciser' %></span>
  </div>

  <% if (t.depart0 || t.arrivee0) { %>
    <p class="trip-communes">
      <%= t.depart0 || '' %><% if (t.depart0 && t.arrivee0) { %> &middot; <% } %><%= t.arrivee0 || '' %>
    </p>
  <% } %>

  <dl class="trip-meta">
    <div>
      <dt>Date</dt>
      <dd><%= formatDate(t.dateData) || t.dateData || 'À préciser' %></dd>
    </div>
    <div>
      <dt>Heure</dt>
      <dd><%= t.time || 'À préciser' %></dd>
    </div>
    <div>
      <dt>Prix</dt>
      <dd><%= t.price || 'À préciser' %></dd>
    </div>
    <div>
      <dt>Places</dt>
      <dd><%= remaining %> / <%= t.places %></dd>
    </div>
    <% if (distance) { %>
      <div>
        <dt>Distance</dt>
        <dd>≈ <%= distance.km %> km<% if (distance.duration) { %> · <%= distance.duration %><% } %></dd>
      </div>
    <% } %>
  </dl>

  <% if (t.description) { %>
    <p class="trip-description"><%= t.description %></p>
  <% } %>

  <div class="trip-card-footer">
    <p class="trip-driver">
      <span class="avatar" aria-hidden="true"><%= driverName.trim().charAt(0) %></span>
      <% if (driverId) { %>
        <a href="/conducteurs/<%= driverId %>"><strong><%= driverName %></strong></a>
      <% } else { %>
        <strong><%= driverName %></strong>
      <% } %>
      <% if (driverRating > 0) { %>
        <span class="trip-rating" title="Note moyenne du conducteur">
          <span aria-hidden="true">&#9733;</span> <%= driverRating.toFixed(1) %><%
          if (driverRatingCount) { %> (<%= driverRatingCount %>)<% } %>
        </span>
      <% } %>
    </p>
    <a class="trip-link" href="/trajets/<%= t._id %>">Voir le trajet &rarr;</a>
  </div>
</article>
