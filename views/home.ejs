<!DOCTYPE html>
<html lang="fr">
  <%- include('./partials/head.ejs') %>
<body>

<%- include('./partials/navbar.ejs') %>

  <main class="content">

   
    <div class="box">
      <div class="empty"></div>
      <div class="part1">Trouvez votre prochaine destination</div>

      <form class="search" action="/trajets" method="get">

        <img src="/home/pics/pos.svg" class="pos">
        <input type="text" class="input1" id="input1" name="arrivee" placeholder="Où souhaitez-vous aller ?">
        <div class="vertical"></div>
      
        <img src="/home/pics/cal.svg" class="cal">
        <input type="date" class="input2" id="input2" name="date" placeholder="Aujourd'hui">
        <div class="vertical"></div>


        <img src="/home/pics/pp.svg" class="pp">
        <input type="number" class="input3" id="input3" name="places" min="1" max="5" placeholder="01">
       
        <button class="look" id="look" type="submit">Rechercher</button>
      </form>

    </div>


    <div class="sanction0">
      <h1 class="subtit0">Pourquoi nous choisir ?</h1>
      
      <div class="subsac0">
        <div class="subbox0">
          <img class="subimg" src="/home/pics/coins.svg">
          <h1 class="tit0">Vos trajets préférés à petits prix</h1>
          <p class="tex0">Où que vous alliez, trouvez le trajet idéal parmi notre large choix de covoiturages.</p>
        </div>

        <div class="subbox1">
          <img class="subimg" src="/home/pics/shield.svg">
          <h1 class="tit1">Voyagez en toute confiance</h1>
          <p class="tex1">Des profils vérifiés et des trajets publiés par la communauté pour voyager sereinement.</p>
        </div>
        <div class="subbox2">
          <img class="subimg" src="/home/pics/flash.svg">
          <h1 class="tit0">Recherchez, cliquez et réservez ! </h1>
          <p class="tex2">Cherchez, comparez et réservez votre place en quelques clics.</p>
        </div>
      </div>

    </div>



    <div class="band">

      <a class="shortcut" href="/trajets?depart=Alger&amp;arrivee=Bejaia"> <p>Alger ⟶ Bejaia &ThinSpace;400DA</p><p class="c">></p> </a>
      <a class="shortcut" href="/trajets?depart=Oran&amp;arrivee=Constantine"> <p>Oran ⟶ Constantine &ThinSpace;1000DA</p><p class="c">></p> </a>
      <a class="shortcut" href="/trajets?depart=Alger&amp;arrivee=Batna"> <p>Alger ⟶ Batna &ThinSpace;500DA</p><p class="c">></p> </a>
    </div>


    <div class="sanction1">

      <div class="half0">
        <div class="color0"><img src="/home/pics/pips.svg" class="pips">  </div>
        
        <div class="element0">
          <h1 class="ht">Découvrez de nouvelles villes sans vous ruiner avec Fi Tri9i</h1>
          <p class="sub-ht">Partagez les frais du trajet et découvrez de nouvelles destinations à petit prix.</p>
          <a href="/trajets" class="but0"><p>Découvrir notre offre</p></a>
        </div>
      </div>

      <div class="half1">
        <div class="element1">
          <h1 class="ht">Voyagez en toute confiance</h1>
          <p class="sub-ht">Chez Fi Tri9i, nous mettons tout en œuvre pour vous proposer une plateforme aussi sécurisée que possible.</p>
          <a href="/a-propos" class="but1"><p>En savoir plus</p></a>
        </div>
        <div class="color1"> <img src="/home/pics/wave.svg" class="wave"> </div>
      </div>


    </div>
    

    <div class="sanction2">


      <div class="card0">
        <img src="/home/pics/poep.svg"  class="last-img1">
       
        <h1 class="bigt0">À propos</h1>
        <p class="smallt">Découvrez notre mission et comment Fi Tri9i facilite le covoiturage en Algérie.</p>
        <a href="/a-propos" class="more">En savoir plus</a>
      </div>

      <div class="card1">
        <img src="/home/pics/paper.svg" class="last-img0">
        <h1 class="bigt1">Comment ça marche</h1>
        <p class="smallt">Publiez votre trajet ou réservez une place en quelques étapes simples.</p>
        <a href="/a-propos" class="more">En savoir plus</a>
      </div>

      <div class="card0">
        <img src="/home/pics/home.svg"  class="last-img2">
        <h1 class="bigt0">Une communauté de confiance</h1>
        <p class="smallt">Rejoignez des milliers de voyageurs et partagez la route en toute simplicité.</p>
        <a href="/trajets" class="more">Voir les trajets</a>
      </div>
    </div>
  </main>
  <%- include('./partials/footer.ejs') %>
<script src="/shared/navbar.js"></script>
