<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Publier un trajet' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 1 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">D'où partez-vous ?</h1>
      <p class="wizard-help">Commencez par la wilaya de départ. Vous pourrez préciser la commune à l'étape suivante.</p>

      <% if (trip) { %>
        <p class="draft-resume">
          Vous avez un brouillon en cours.
          <a href="/publier/continuer">Reprendre là où vous en étiez</a>
        </p>
      <% } %>

      <form class="wizard-form" action="/depart" method="post">
        <%- include('../partials/csrf-input.ejs') %>
        <label class="field">
          <span>Wilaya de départ</span>
          <input type="text" name="depart" id="commencer" placeholder="ex : Alger" value="<%= trip && trip.depart ? trip.depart : '' %>" required autofocus>
        </label>
        <div class="wizard-actions">
          <a class="btn ghost" href="/mes-trajets">Annuler</a>
          <button class="btn" id="suiv" type="submit">Continuer &rarr;</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/shared/navbar.js"></script>
</body>
</html>
