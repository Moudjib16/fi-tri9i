<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Publier un trajet' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 3 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">Où allez-vous ?</h1>
      <p class="wizard-help">Indiquez la wilaya d'arrivée de votre trajet.</p>

      <form class="wizard-form" action="/arrivee" method="post">
        <%- include('../partials/csrf-input.ejs') %>
        <label class="field">
          <span>Wilaya d'arrivée</span>
          <input type="text" name="arrivee" id="commencer" list="wilayas" placeholder="ex : Béjaïa" value="<%= trip && trip.arrivee ? trip.arrivee : '' %>" required autofocus>
        </label>
        <%- include('../partials/wilaya-list.ejs') %>
        <div class="wizard-actions">
          <button class="btn secondary precedent" id="prec" type="button">Précédent</button>
          <button class="btn" id="suiv" type="submit">Continuer &rarr;</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/publier/page3/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
