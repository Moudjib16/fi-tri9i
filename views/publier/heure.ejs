<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Choisir une heure' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 6 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">À quelle heure partez-vous ?</h1>
      <p class="wizard-help">Choisissez une heure de départ entre 06:00 et minuit.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error" role="alert">
          <% if (error === 'past') { %>Cette heure est déjà passée. Choisissez une heure à venir.
          <% } else { %>Choisissez une heure valide pour continuer.<% } %>
        </p>
      <% } %>
      <p id="wizard-error" class="form-error" role="alert" hidden></p>

      <div class="time-picker">
        <% const currentTime = trip && trip.time ? trip.time : '08 : 00'; %>
        <div class="time-input-row">
          <input class="time-value" maxlength="6" type="text" value="<%= currentTime %>" id="clock" name="timeData" aria-label="Heure de départ" role="combobox" aria-haspopup="listbox" aria-controls="time-menu" aria-expanded="false" aria-autocomplete="none" inputmode="numeric">
          <button class="time-toggle" id="arr" type="button" aria-label="Choisir une heure" aria-haspopup="listbox" aria-controls="time-menu" aria-expanded="false">&rsaquo;</button>
        </div>

        <div class="time-menu" id="time-menu" role="listbox" aria-label="Heures de départ disponibles" tabindex="-1">
          <% for (let minutes = 370; minutes <= 1430; minutes += 10) { %>
            <% const hours = Math.floor(minutes / 60); const mins = minutes % 60; const value = `${String(hours).padStart(2, '0')} : ${String(mins).padStart(2, '0')}`; %>
            <button class="time-option" type="button" role="option" aria-selected="<%= currentTime === value ? 'true' : 'false' %>" tabindex="-1"><%= value %></button>
          <% } %>
          <button class="time-option" type="button" role="option" aria-selected="<%= currentTime === '00 : 00' ? 'true' : 'false' %>" tabindex="-1">00 : 00</button>
        </div>
        <div class="time-backdrop" id="white"></div>
      </div>

      <div class="wizard-actions">
        <button class="btn secondary precedent" id="precedent" type="button">Précédent</button>
        <button class="btn" id="prochaine" type="button">Continuer &rarr;</button>
      </div>
    </section>
  </main>

  <script src="/shared/wizard.js"></script>
  <script src="/publier/heure/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
