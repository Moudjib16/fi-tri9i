<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Choisir une date' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 5 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">Quand partez-vous ?</h1>
      <p class="wizard-help">Choisissez la date de votre départ. Vous pourrez ajuster l'heure à l'étape suivante.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error" role="alert">
          <% if (error === 'past') { %>Cette date est déjà passée. Choisissez une date à venir.
          <% } else { %>Choisissez une date valide pour continuer.
          <% } %>
        </p>
      <% } %>
      <p id="wizard-error" class="form-error" role="alert" hidden></p>

      <div class="calendar-grid">
        <div class="calendar-panel calendar">
          <div class="month">
            <button class="prev" type="button" aria-label="Mois précédent" aria-controls="calendar-days">&larr;</button>
            <div class="date" id="calendar-month" aria-live="polite">Janvier 2026</div>
            <button class="next" type="button" aria-label="Mois suivant" aria-controls="calendar-days">&rarr;</button>
          </div>
          <div class="weekdays" aria-hidden="true">
            <div>D</div>
            <div>L</div>
            <div>M</div>
            <div>M</div>
            <div>J</div>
            <div>V</div>
            <div>S</div>
          </div>
          <div class="days" id="calendar-days" role="group" aria-labelledby="calendar-month"></div>
          <div class="goto-today">
            <div class="goto">
              <input type="text" placeholder="mm/yyyy" class="date-input" aria-label="Aller à un mois" inputmode="numeric">
              <button class="goto-btn" type="button">Aller</button>
            </div>
            <button class="today-btn" type="button">Aujourd'hui</button>
          </div>
        </div>

        <aside class="calendar-side">
          <div class="event-day">Choisir</div>
          <div class="event-date" id="dateData" aria-live="polite" data-initial="<%= trip && trip.dateData ? formatDateIso(trip.dateData) : '' %>" data-iso="<%= trip && trip.dateData ? formatDateIso(trip.dateData) : '' %>"><%= trip && trip.dateData ? formatDate(trip.dateData) : '' %></div>
          <div class="events">Sélectionnez un jour dans le calendrier pour continuer.</div>
        </aside>
      </div>

      <div class="wizard-actions">
        <button class="btn secondary precedent" id="precedent" type="button">Précédent</button>
        <button class="btn" id="prochaine" type="button">Continuer &rarr;</button>
      </div>
    </section>
  </main>

  <script src="/shared/wizard.js"></script>
  <script src="/publier/calendaire/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
