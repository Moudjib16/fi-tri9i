<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/publier/description/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Serif:wght@400;700&display=swap">
  <title >Fi Tri9i</title>
</head>
<body>

<%- include('../partials/navbar.ejs') %>


  <main class="content">
    <div class="row-btn"> 
      <button id="btn1" ></button>
      <button id="btn2" ></button>
      <button id="btn3" ></button>
      <button id="btn4" ></button>
      <button id="btn5" ></button>
      <button id="btn6" ></button>
      <button id="btn7" ></button>
      <button id="btn8" ></button>
      <button id="btn9" ></button>
    </div>
    <h1 class="title">Quelque chose à ajouter sur votre trajet ?</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="form-error" style="color: #b00020; text-align: center; margin-bottom: 12px;">
        <% if (error === 'description') { %>La description est trop longue.
        <% } else { %>Certaines étapes sont incomplètes. Vérifiez la date, l'heure et le prix.
        <% } %>
      </p>
    <% } %>
    <form action="/publier/publier" method="post">
      <textarea maxlength="1000" class="in" placeholder="Bonjour ! je vais voir ma famille. J'ai beaucoup de place dans le coffre." id="description" name="description"><%= trip && trip.description ? trip.description : '' %></textarea>
      <div class="row1">
        <button class="precedent" id="precedent" type="button">précédent</button>
        <button class="prochaine" id="prochaine" type="submit">publier</button>
      </div>
    </form>
  </main>

<script src="/publier/description/script.js"></script>
<script src="/shared/navbar.js"></script>
</body>
</html>