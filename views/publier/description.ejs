<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Dernière étape' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 9 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Dernière étape</p>
      <h1 class="wizard-title">Quelque chose à ajouter ?</h1>
      <p class="wizard-help">Une précision sur le point de rendez-vous, les bagages ou l'ambiance du trajet aide les passagers à se décider.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error" role="alert">
          <% if (error === 'description') { %>La description est trop longue.
          <% } else { %>Certaines étapes sont incomplètes. Vérifiez la date, l'heure et le prix.
          <% } %>
        </p>
      <% } %>

      <% if (trip) { %>
        <div class="wizard-summary">
          <div>
            <span>Trajet</span>
            <strong><%= trip.depart %><% if (trip.arrivee) { %> &rarr; <%= trip.arrivee %><% } %></strong>
          </div>
          <div>
            <span>Date</span>
            <strong><%= trip.dateData || 'À préciser' %><% if (trip.time) { %> · <%= trip.time %><% } %></strong>
          </div>
          <div>
            <span>Places</span>
            <strong><%= trip.places || 1 %></strong>
          </div>
          <div>
            <span>Prix</span>
            <strong><%= trip.price || 'À préciser' %></strong>
          </div>
        </div>
      <% } %>

      <form class="wizard-form" action="/publier/publier" method="post">
        <%- include('../partials/csrf-input.ejs') %>
        <label class="field">
          <span>Description du trajet</span>
          <textarea maxlength="1000" placeholder="Bonjour ! Je vais voir ma famille. J'ai de la place dans le coffre et je pars à l'heure." id="description" name="description"><%= trip && trip.description ? trip.description : '' %></textarea>
        </label>
        <div class="wizard-actions">
          <button class="btn secondary precedent" id="precedent" type="button">Précédent</button>
          <button class="btn" id="prochaine" type="submit">Publier le trajet</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/publier/description/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
