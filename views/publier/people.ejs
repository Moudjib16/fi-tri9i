<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Choisir le nombre de places' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 7 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">Combien de places proposez-vous ?</h1>
      <p class="wizard-help">Cinq places maximum par trajet, pour garder un voyage confortable.</p>

      <p id="wizard-error" class="form-error" role="alert" hidden></p>

      <div class="counter">
        <button class="minuss" id="minuss" type="button" aria-label="Retirer une place">&minus;</button>
        <input value="<%= trip && trip.places ? trip.places : 1 %>" id="prix" maxlength="6" inputmode="numeric" aria-label="Nombre de places">
        <button class="pluss" id="pluss" type="button" aria-label="Ajouter une place">+</button>
      </div>

      <div class="seat-preview" aria-hidden="true">
        <span class="seat-dot" id="p1">1</span>
        <span class="seat-dot" id="p2">2</span>
        <span class="seat-dot" id="p3">3</span>
        <span class="seat-dot" id="p4">4</span>
        <span class="seat-dot" id="p5">5</span>
      </div>

      <div class="wizard-actions">
        <button class="btn secondary precedent" id="precedent" type="button">Précédent</button>
        <button class="btn" id="prochaine" type="button">Continuer &rarr;</button>
      </div>
    </section>
  </main>

  <script src="/shared/wizard.js"></script>
  <script src="/publier/people/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
