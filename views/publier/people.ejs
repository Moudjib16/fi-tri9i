<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/publier/people/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Serif:wght@400;700&display=swap">
  <title >Fi Tri9i</title>
</head>
<body>

<%- include('../partials/navbar.ejs') %>


  <main class="content">
    <div class="row-btn"> 
      <button id="btn1" ></button>
      <button id="btn2" ></button>
      <button id="btn3" ></button>
      <button id="btn4" ></button>
      <button id="btn5" ></button>
      <button id="btn6" ></button>
      <button id="btn7" ></button>
      <button id="btn8" ></button>
      <button id="btn9" ></button>
    </div>
    <h1 class="title">Combien de places proposez-vous ?</h1>
   
   
      <div class="row1">
        <button class="minuss" id="minuss">−</button>
        <input value="1" class="prix" id="prix" maxlength="6" >
        <button class="pluss" id="pluss">+</button>
      </div>

      <div class="pips">
        <img class="p1" id="p1" src="/publier/people/pics/p1.svg">
        <img class="p2" id="p2" src="/publier/people/pics/p1.svg">
        <img class="p3" id="p3" src="/publier/people/pics/p1.svg">
        <img class="p4" id="p4" src="/publier/people/pics/p1.svg">
        <img class="p5" id="p5" src="/publier/people/pics/p1.svg">
    

      </div>

   
    <div class="row1">
      <button class="precedent" id="precedent">précédent</button>
      <button class="prochaine" id="prochaine">continuer</button>
    </div>
  </main>


  <script>
    document.getElementById('prochaine').addEventListener('click', async () => {
         const content = document.getElementById('prix').value;
         try {
             const response = await fetch('/places', {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json',
                 },
                 body: JSON.stringify({ content }),
             });
             if (response.ok) {
                 window.location.href = '/publier/prix';
             } else {
                 alert('Nombre de places invalide (1 à 8).');
             }
         } catch (error) {
             console.error('Error:', error);
             alert('Erreur réseau, réessayez.');
         }
     });
  </script>
<script src="/publier/people/script.js"></script>
</body>
</html>