<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Publier un trajet' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 4 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">Précisez votre destination.</h1>
      <p class="wizard-help">La commune d'arrivée donne aux passagers une idée précise du trajet.</p>

      <form class="wizard-form" action="/arrivee0" method="post">
        <%- include('../partials/csrf-input.ejs') %>
        <label class="field">
          <span>Commune d'arrivée</span>
          <input type="text" name="arrivee0" id="commencer" placeholder="ex : Amizour" value="<%= trip && trip.arrivee0 ? trip.arrivee0 : '' %>" required autofocus>
        </label>
        <div class="wizard-actions">
          <button class="btn secondary precedent" id="prec" type="button">Précédent</button>
          <button class="btn" id="suiv" type="submit">Continuer &rarr;</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/publier/page4/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
