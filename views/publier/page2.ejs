<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head.ejs', { title: 'Publier un trajet' }) %>
<body>
  <%- include('../partials/navbar.ejs') %>

  <main class="wizard-shell">
    <%- include('../partials/wizard-progress.ejs', { step: 2 }) %>

    <section class="wizard-card">
      <p class="eyebrow">Publier un trajet</p>
      <h1 class="wizard-title">Précisez votre point de départ.</h1>
      <p class="wizard-help">La commune aide les passagers à trouver un point de rendez-vous clair.</p>

      <form class="wizard-form" action="/depart0" method="post">
        <%- include('../partials/csrf-input.ejs') %>
        <label class="field">
          <span>Commune de départ</span>
          <input type="text" name="depart0" id="commencer" list="communes" placeholder="ex : Bab Ezzouar" value="<%= trip && trip.depart0 ? trip.depart0 : '' %>" required autofocus>
        </label>
        <%- include('../partials/commune-list.ejs', { id: 'communes', communes: communes }) %>
        <div class="wizard-actions">
          <button class="btn secondary precedent" id="prec" type="button">Précédent</button>
          <button class="btn" id="suiv" type="submit">Continuer &rarr;</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/publier/page2/script.js"></script>
  <script src="/shared/navbar.js"></script>
</body>
</html>
