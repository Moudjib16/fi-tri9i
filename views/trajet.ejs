<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Détail du trajet' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="site-main detail-page">
    <a class="back-link" href="/trajets">&larr; Retour aux trajets</a>

    <% if (typeof isDraft !== 'undefined' && isDraft) { %>
      <div class="banner">
        Ce trajet est encore un brouillon : il n'apparaît pas dans la recherche.
        <a href="/publier/continuer/<%= trip._id %>">Continuer la publication</a>
      </div>
    <% } %>

    <div class="detail-layout">
      <article class="detail-card">
        <header class="detail-header">
          <p class="detail-kicker">Détail du trajet</p>
          <h1>
            <span><%= trip.depart %></span>
            <span class="route-arrow">&rarr;</span>
            <span><%= trip.arrivee || 'Destination à préciser' %></span>
          </h1>
          <% if (trip.depart0 || trip.arrivee0) { %>
            <p class="detail-communes">
              <%= trip.depart0 || '' %><% if (trip.depart0 && trip.arrivee0) { %> &middot; <% } %><%= trip.arrivee0 || '' %>
            </p>
          <% } %>
        </header>

        <dl class="trip-meta detail-meta">
          <div>
            <dt>Date</dt>
            <dd><%= trip.dateData || 'À préciser' %></dd>
          </div>
          <div>
            <dt>Heure</dt>
            <dd><%= trip.time || 'À préciser' %></dd>
          </div>
          <div>
            <dt>Prix par place</dt>
            <dd><%= trip.price || 'À préciser' %></dd>
          </div>
          <div>
            <dt>Places restantes</dt>
            <dd><%= remaining %> / <%= trip.places %></dd>
          </div>
        </dl>

        <section class="detail-section">
          <h2>Conducteur</h2>
          <% const driverName = trip.driver && trip.driver.name ? trip.driver.name : 'Anonyme'; %>
          <% const driverId = trip.driver && trip.driver._id ? trip.driver._id : null; %>
          <% if (driverId) { %>
            <a class="driver-card" href="/conducteurs/<%= driverId %>">
          <% } else { %>
            <div class="driver-card">
          <% } %>
            <span class="avatar" aria-hidden="true"><%= driverName.trim().charAt(0) %></span>
            <div>
              <strong><%= driverName %></strong>
              <span>Conducteur sur Fi Tri9i<% if (driverId) { %> &middot; Voir le profil<% } %></span>
            </div>
          <% if (driverId) { %>
            </a>
          <% } else { %>
            </div>
          <% } %>
        </section>

        <% if (trip.description) { %>
          <section class="detail-section">
            <h2>À propos du trajet</h2>
            <p><%= trip.description %></p>
          </section>
        <% } %>

        <section class="detail-section">
          <h2>Bon à savoir</h2>
          <p>Le prix est à régler directement au conducteur. Les places sont limitées à cinq par trajet pour garder un voyage confortable.</p>
        </section>
      </article>

      <aside class="detail-aside">
        <div class="booking-card">
          <p class="booking-label">Prix par place</p>
          <div class="booking-price">
            <strong><%= trip.price || '—' %></strong>
          </div>

          <dl class="booking-facts">
            <div>
              <dt>Date</dt>
              <dd><%= trip.dateData || 'À préciser' %></dd>
            </div>
            <div>
              <dt>Départ</dt>
              <dd><%= trip.time || 'À préciser' %></dd>
            </div>
            <div>
              <dt>Places</dt>
              <dd><%= remaining %> restante<%= remaining === 1 ? '' : 's' %></dd>
            </div>
            <div>
              <dt>Conducteur</dt>
              <dd><%= driverName %></dd>
            </div>
          </dl>

          <div class="detail-actions">
            <% if (isDriver) { %>
              <span class="status-badge">Votre trajet</span>
              <% if (typeof isDraft !== 'undefined' && isDraft) { %>
                <form action="/trajets/<%= trip._id %>/supprimer" method="post" data-confirm="Supprimer ce brouillon ?">
                  <%- include('./partials/csrf-input.ejs') %>
                  <button type="submit" class="btn danger block">Supprimer le brouillon</button>
                </form>
              <% } else if (typeof isCancelled !== 'undefined' && isCancelled) { %>
                <span class="status-badge muted-badge">Trajet annulé</span>
              <% } else if (typeof hasDeparted !== 'undefined' && hasDeparted) { %>
                <span class="status-badge muted-badge">Trajet passé</span>
              <% } else { %>
                <form action="/trajets/<%= trip._id %>/annuler-trajet" method="post" data-confirm="Annuler ce trajet ? Les passagers devront chercher une autre place.">
                  <%- include('./partials/csrf-input.ejs') %>
                  <button type="submit" class="btn danger block">Annuler le trajet</button>
                </form>
              <% } %>
            <% } else if (typeof isCancelled !== 'undefined' && isCancelled) { %>
              <span class="status-badge muted-badge">Annulé par le conducteur</span>
            <% } else if (isBooked && typeof hasDeparted !== 'undefined' && hasDeparted) { %>
              <span class="status-badge muted-badge">Trajet passé</span>
            <% } else if (isBooked) { %>
              <span class="status-badge">Place réservée</span>
              <form action="/trajets/<%= trip._id %>/annuler" method="post">
                <%- include('./partials/csrf-input.ejs') %>
                <button type="submit" class="btn secondary block">Annuler ma réservation</button>
              </form>
            <% } else if (typeof hasDeparted !== 'undefined' && hasDeparted) { %>
              <span class="status-badge muted-badge">Trajet passé</span>
            <% } else if (remaining <= 0) { %>
              <span class="status-badge muted-badge">Trajet complet</span>
            <% } else if (!currentUser) { %>
              <a class="btn block" href="/login?next=<%= encodeURIComponent('/trajets/' + trip._id) %>">Se connecter pour réserver</a>
            <% } else { %>
              <form action="/trajets/<%= trip._id %>/reserver" method="post">
                <%- include('./partials/csrf-input.ejs') %>
                <button type="submit" class="btn block">Réserver une place</button>
              </form>
            <% } %>
          </div>

          <p class="booking-note">Aucun paiement en ligne. Vous réglez directement le conducteur le jour du départ.</p>
        </div>
      </aside>
    </div>
  </main>

  <%- include('./partials/footer.ejs') %>
  <script src="/shared/navbar.js"></script>
</body>
</html>
