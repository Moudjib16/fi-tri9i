<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Nouveau mot de passe' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="auth-body">
    <section class="auth-layout">
      <aside class="auth-aside">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 19c6 0 3-8 9-8 2.2 0 3.4 1.2 5 1.8"></path>
              <circle cx="5" cy="19" r="2"></circle>
              <circle cx="19" cy="13" r="2"></circle>
            </svg>
          </span>
          <span class="brand-copy">
            <strong>Fi Tri9i</strong>
            <span>Covoiturage</span>
          </span>
        </a>
        <h1>Nouveau départ.</h1>
        <p>Choisissez un nouveau mot de passe pour retrouver vos trajets.</p>
        <p class="auth-quote">Votre lien est à usage unique et expire rapidement.</p>
      </aside>

      <div class="auth-card">
        <p class="eyebrow">Sécurité</p>
        <h2>Nouveau mot de passe</h2>

        <% if (invalid) { %>
          <p class="form-error" role="alert"><%= error %></p>
          <p class="auth-switch"><a href="/mot-de-passe-oublie">Demander un nouveau lien</a></p>
        <% } else { %>
          <p class="auth-intro">Choisissez un mot de passe d'au moins 6 caractères.</p>
          <form class="auth-form" action="/reinitialiser-mot-de-passe/<%= encodeURIComponent(token) %>" method="post">
            <%- include('./partials/csrf-input.ejs') %>
            <label class="field">
              <span>Nouveau mot de passe</span>
              <input type="password" name="password" autocomplete="new-password" minlength="6" maxlength="72" required>
            </label>
            <label class="field">
              <span>Confirmer le mot de passe</span>
              <input type="password" name="confirm-password" autocomplete="new-password" minlength="6" maxlength="72" required>
            </label>
            <% if (error) { %>
              <p class="form-error" role="alert"><%= error %></p>
            <% } %>
            <button class="btn block" type="submit">Réinitialiser le mot de passe</button>
          </form>
        <% } %>

        <p class="auth-switch"><a href="/login">Retour à la connexion</a></p>
      </div>
    </section>
  </main>

  <script src="/shared/navbar.js"></script>
</body>
</html>
