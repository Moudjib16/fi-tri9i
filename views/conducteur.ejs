<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: `Conducteur · ${driver.name}` }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="site-main profile-page">
    <a class="back-link" href="/trajets">&larr; Retour aux trajets</a>

    <% const memberSince = driver.createdAt
      ? new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date(driver.createdAt))
      : ''; %>
    <% const initial = driver.name ? driver.name.trim().charAt(0) : '?'; %>

    <header class="profile-hero">
      <span class="avatar profile-avatar" aria-hidden="true"><%= initial %></span>
      <div class="profile-heading">
        <p class="eyebrow">Conducteur</p>
        <h1><%= driver.name %></h1>
        <p>Membre de la communauté Fi Tri9i<% if (memberSince) { %> depuis <%= memberSince %><% } %>.</p>
      </div>
      <div class="profile-stats" aria-label="Profil du conducteur">
        <div>
          <strong><%= upcomingTrips.length %></strong>
          <span>trajet<%= upcomingTrips.length === 1 ? '' : 's' %> à venir</span>
        </div>
        <div>
          <strong><%= ratingCount ? ratingAverage.toFixed(1) : '—' %></strong>
          <span><%= ratingCount %> avis</span>
        </div>
      </div>
    </header>

    <section class="results profile-trips">
      <div class="results-head">
        <h2>Trajets à venir</h2>
        <a class="publish-link" href="/trajets">Tous les trajets</a>
      </div>

      <% if (!upcomingTrips.length) { %>
        <div class="empty-state">
          <h3>Aucun trajet à venir pour le moment.</h3>
          <p>Explorez les autres trajets disponibles ou revenez plus tard.</p>
          <a class="btn" href="/trajets">Trouver un trajet</a>
        </div>
      <% } else { %>
        <div class="trip-grid">
          <% upcomingTrips.forEach(function (t) { %>
            <%- include('./partials/trip-card.ejs', { t }) %>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section class="results profile-reviews">
      <div class="results-head">
        <h2>Avis des passagers</h2>
        <% if (ratingCount) { %>
          <span class="pill"><%= ratingCount %> avis</span>
        <% } %>
      </div>

      <% if (!reviews.length) { %>
        <div class="empty-state">
          <h3>Aucun avis pour le moment.</h3>
          <p>Les passagers pourront donner leur avis après un trajet.</p>
        </div>
      <% } else { %>
        <div class="review-list">
          <% reviews.forEach(function (review) { %>
            <%
              const authorName = review.author && review.author.name
                ? review.author.name
                : 'Passager';
              const reviewDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' })
                .format(new Date(review.createdAt));
            %>
            <article class="review-card">
              <div class="review-head">
                <span class="avatar" aria-hidden="true"><%= authorName.trim().charAt(0) %></span>
                <div class="review-author">
                  <strong><%= authorName %></strong>
                  <time datetime="<%= new Date(review.createdAt).toISOString() %>"><%= reviewDate %></time>
                </div>
                <span class="review-stars" aria-label="<%= review.rating %> sur 5">
                  <span><%= '★'.repeat(review.rating) %></span><span class="review-stars-empty"><%= '★'.repeat(5 - review.rating) %></span>
                </span>
              </div>
              <% if (review.comment) { %>
                <p><%= review.comment %></p>
              <% } else { %>
                <p class="review-empty">Aucun commentaire.</p>
              <% } %>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <p class="report-footer">
      <a class="report-link" href="/conducteurs/<%= driver._id %>/signaler">Signaler ce conducteur</a>
    </p>
  </main>

  <%- include('./partials/footer.ejs') %>
  <script src="/shared/navbar.js"></script>
</body>
</html>
