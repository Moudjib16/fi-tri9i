<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Trajets' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="site-main">
    <header class="page-hero">
      <div>
        <p class="eyebrow">Trouver un trajet</p>
        <h1>Votre prochaine destination.</h1>
        <p>Comparez les trajets publiés par la communauté et réservez la place qui vous convient.</p>
      </div>
      <a class="btn secondary" href="/publier/page1">Publier un trajet</a>
    </header>

    <section class="search-card" aria-label="Filtrer les trajets">
      <form class="trip-search" action="/trajets" method="get">
        <label class="field">
          <span>Départ</span>
          <input type="text" name="depart" value="<%= filters.depart %>" placeholder="ex : Alger">
        </label>
        <label class="field">
          <span>Arrivée</span>
          <input type="text" name="arrivee" value="<%= filters.arrivee %>" placeholder="ex : Béjaïa">
        </label>
        <label class="field">
          <span>Date</span>
          <input type="date" name="date" value="<%= filters.date %>">
        </label>
        <label class="field">
          <span>Places</span>
          <input type="number" name="places" min="1" max="5" value="<%= filters.places %>" placeholder="1">
        </label>
        <label class="field">
          <span>Trier par</span>
          <select name="sort">
            <option value="soonest" <%= filters.sort === 'soonest' ? 'selected' : '' %>>Départ le plus proche</option>
            <option value="price" <%= filters.sort === 'price' ? 'selected' : '' %>>Prix croissant</option>
            <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Publication récente</option>
          </select>
        </label>
        <button class="btn" type="submit">Rechercher</button>
      </form>
    </section>

    <section class="results">
      <div class="results-head">
        <h2><%= pagination.total %> trajet<%= pagination.total === 1 ? '' : 's' %> trouvé<%= pagination.total === 1 ? '' : 's' %></h2>
        <a class="publish-link" href="/trajets">Réinitialiser les filtres</a>
      </div>

      <% if (!trips.length) { %>
        <div class="empty-state">
          <h3>Aucun trajet ne correspond à votre recherche.</h3>
          <p>Essayez un autre itinéraire, une autre date, ou publiez votre propre trajet.</p>
          <a class="btn" href="/publier/page1">Publier un trajet</a>
        </div>
      <% } else { %>
        <div class="trip-grid">
          <% trips.forEach(function (t) { %>
            <%- include('./partials/trip-card.ejs', { t }) %>
          <% }); %>
        </div>

        <% if (pagination.pages > 1) { %>
          <% const queryPrefix = pagination.baseQuery ? `${pagination.baseQuery}&` : ''; %>
          <nav class="pagination" aria-label="Pagination des trajets">
            <% if (pagination.page > 1) { %>
              <a href="/trajets?<%= queryPrefix %>page=<%= pagination.page - 1 %>">Précédent</a>
            <% } else { %>
              <span class="disabled">Précédent</span>
            <% } %>
            <span>Page <%= pagination.page %> / <%= pagination.pages %></span>
            <% if (pagination.page < pagination.pages) { %>
              <a href="/trajets?<%= queryPrefix %>page=<%= pagination.page + 1 %>">Suivant</a>
            <% } else { %>
              <span class="disabled">Suivant</span>
            <% } %>
          </nav>
        <% } %>
      <% } %>
    </section>
  </main>

  <%- include('./partials/footer.ejs') %>
  <script src="/shared/navbar.js"></script>
</body>
</html>
