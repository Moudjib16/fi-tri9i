<!DOCTYPE html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fi Tri9i | Connexion</title>
    <link rel="stylesheet" href="/shared/navbar.css">
    <link rel="stylesheet" href="/login/login.css">
    <link rel="stylesheet" href="/shared/auth.css">
  </head>
<body>
  <%- include('./partials/navbar.ejs') %>

  <div class="wrapper">
    <h2>Connexion</h2>
    <form action="/login" method="post">
      <%- include('./partials/csrf-input.ejs') %>
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
      <div class="input-box">
        <input type="email" name="email" placeholder="Votre email" autocomplete="email" required>
      </div>
      <div class="input-box">
        <input type="password" name="password" placeholder="Votre mot de passe" autocomplete="current-password" required>
      </div>
      <div class="input-box button">
        <input type="submit" value="Se connecter">
      </div>
      <div class="text">
        <h3>Pas encore de compte ? <a href="/signup">S'inscrire</a></h3>
      </div>
    </form>
  </div>

  <script src="/shared/navbar.js"></script>
</body>
</html>
