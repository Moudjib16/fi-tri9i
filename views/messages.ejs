<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Messages du trajet' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="wizard-shell messages-page">
    <a class="back-link" href="/trajets/<%= trip._id %>">&larr; Retour au trajet</a>

    <section class="wizard-card messages-card">
      <header class="messages-header">
        <p class="eyebrow">Messages du trajet</p>
        <h1><%= trip.depart %> &rarr; <%= trip.arrivee || 'Destination à préciser' %></h1>
        <p class="messages-meta">
          <%= trip.dateData || 'Date à préciser' %> &middot; <%= trip.time || 'Heure à préciser' %>
          &middot; Conducteur : <%= driverName %>
        </p>
        <p class="messages-role">Vous participez à ce trajet en tant que <%= isDriver ? 'conducteur' : 'passager' %>.</p>
      </header>

      <% if (error) { %>
        <p class="form-error messages-error" role="alert"><%= error %></p>
      <% } %>

      <div class="message-list">
        <% if (!messages.length) { %>
          <div class="messages-empty">
            <h2>Aucun message pour le moment.</h2>
            <p>Posez une question ou partagez les détails du rendez-vous.</p>
          </div>
        <% } %>

        <% messages.forEach(function (message) { %>
          <%
            const senderName = message.sender && message.sender.name
              ? message.sender.name
              : 'Utilisateur';
            const senderId = message.sender && message.sender._id
              ? String(message.sender._id)
              : String(message.sender || '');
            const own = currentUser && String(currentUser._id) === senderId;
            const created = new Date(message.createdAt);
          %>
          <article class="message<%= own ? ' is-own' : '' %>">
            <span class="avatar message-avatar" aria-hidden="true"><%= senderName.charAt(0).toUpperCase() %></span>
            <div class="message-bubble">
              <div class="message-head">
                <strong><%= own ? 'Vous' : senderName %></strong>
                <time datetime="<%= created.toISOString() %>"><%= created.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' }) %></time>
              </div>
              <p class="message-body"><%= message.body %></p>
            </div>
          </article>
        <% }); %>
      </div>

      <form class="message-form" action="/trajets/<%= trip._id %>/messages" method="post">
        <%- include('./partials/csrf-input.ejs') %>
        <label class="field">
          <span>Votre message</span>
          <textarea name="message" maxlength="1000" required placeholder="Bonjour, à quelle heure vous retrouve-t-on ?"><%= draft %></textarea>
        </label>
        <div class="message-form-footer">
          <p>Seuls le conducteur et les passagers réservés peuvent lire ces messages.</p>
          <button class="btn" type="submit">Envoyer</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/shared/navbar.js" defer></script>
</body>
</html>
