<!DOCTYPE html>
<html lang="fr">
<%- include('./partials/head.ejs', { title: 'Mon compte' }) %>
<body>
  <%- include('./partials/navbar.ejs') %>

  <main class="site-main account-page">
    <a class="back-link" href="/">&larr; Retour à l'accueil</a>

    <% const role = currentUser.userType === 2 ? 'Conducteur' : 'Passager'; %>
    <% const initial = currentUser.name ? currentUser.name.trim().charAt(0) : '?'; %>
    <%
      const profileValues = (typeof profile !== 'undefined' && profile) ? profile : {
        name: currentUser.name || '',
        phone: currentUser.phone || '',
        bio: currentUser.bio || '',
        userType: currentUser.userType,
        emailNotifications: currentUser.emailNotifications !== false,
      };
    %>

    <header class="account-hero">
      <span class="avatar account-avatar" aria-hidden="true"><%= initial %></span>
      <div class="account-identity">
        <p class="eyebrow">Mon compte</p>
        <h1><%= currentUser.name %></h1>
        <p><%= currentUser.email %></p>
      </div>
      <span class="account-role"><%= role %></span>
    </header>

    <section class="wizard-card account-card">
      <p class="eyebrow">Email</p>
      <h2>Adresse email</h2>
      <% if (currentUser.emailVerified === false) { %>
        <p class="wizard-help">
          Votre adresse email n'est pas encore vérifiée. Confirmez-la pour sécuriser votre compte.
        </p>
        <form class="wizard-form account-form" action="/verifier-email/renvoyer" method="post">
          <%- include('./partials/csrf-input.ejs') %>
          <div class="wizard-actions">
            <button class="btn" type="submit">Renvoyer l'email de vérification</button>
          </div>
        </form>
      <% } else { %>
        <p class="wizard-help">Votre adresse email est vérifiée.</p>
      <% } %>
    </section>

    <section class="wizard-card account-card">
      <p class="eyebrow">Profil</p>
      <h2>Mes informations</h2>
      <p class="wizard-help">
        Votre nom et votre présentation apparaissent sur votre profil public.
        Votre numéro de téléphone reste privé.
      </p>

      <form class="wizard-form account-form" action="/compte/profil" method="post">
        <%- include('./partials/csrf-input.ejs') %>

        <label class="field">
          <span>Nom</span>
          <input type="text" name="name" value="<%= profileValues.name %>" minlength="2" maxlength="60" required>
        </label>
        <% if (errors.name) { %>
          <p class="form-error" role="alert"><%= errors.name %></p>
        <% } %>

        <label class="field">
          <span>Téléphone (privé)</span>
          <input type="tel" name="phone" value="<%= profileValues.phone %>" maxlength="20" placeholder="0555 12 34 56">
        </label>
        <% if (errors.phone) { %>
          <p class="form-error" role="alert"><%= errors.phone %></p>
        <% } %>

        <label class="field">
          <span>Je suis</span>
          <select name="userType">
            <option value="1" <%= Number(profileValues.userType) === 1 ? 'selected' : '' %>>Passager</option>
            <option value="2" <%= Number(profileValues.userType) === 2 ? 'selected' : '' %>>Conducteur</option>
          </select>
        </label>
        <% if (errors.userType) { %>
          <p class="form-error" role="alert"><%= errors.userType %></p>
        <% } %>

        <label class="field">
          <span>Présentation</span>
          <textarea name="bio" rows="3" maxlength="300" class="compact" placeholder="Quelques mots sur vous"><%= profileValues.bio %></textarea>
        </label>
        <% if (errors.bio) { %>
          <p class="form-error" role="alert"><%= errors.bio %></p>
        <% } %>

        <div class="policy account-check">
          <input type="checkbox" name="emailNotifications" id="emailNotifications" <%= profileValues.emailNotifications !== false ? 'checked' : '' %>>
          <label for="emailNotifications">Recevoir les notifications de l'application par email.</label>
        </div>

        <div class="wizard-actions">
          <button class="btn" type="submit">Enregistrer</button>
        </div>
      </form>
    </section>

    <section class="wizard-card account-card">
      <p class="eyebrow">Sécurité</p>
      <h2>Changer de mot de passe</h2>
      <p class="wizard-help">
        Votre nouveau mot de passe doit contenir au moins 6 caractères.
        Vous resterez connecté après la modification.
      </p>

      <form class="wizard-form account-form" action="/compte/mot-de-passe" method="post">
        <%- include('./partials/csrf-input.ejs') %>

        <label class="field">
          <span>Mot de passe actuel</span>
          <input type="password" name="currentPassword" autocomplete="current-password" required>
        </label>
        <% if (errors.currentPassword) { %>
          <p class="form-error" role="alert"><%= errors.currentPassword %></p>
        <% } %>

        <label class="field">
          <span>Nouveau mot de passe</span>
          <input type="password" name="password" autocomplete="new-password" minlength="6" maxlength="72" required>
        </label>
        <% if (errors.password) { %>
          <p class="form-error" role="alert"><%= errors.password %></p>
        <% } %>

        <label class="field">
          <span>Confirmer le nouveau mot de passe</span>
          <input type="password" name="confirm-password" autocomplete="new-password" minlength="6" maxlength="72" required>
        </label>
        <% if (errors.confirmPassword) { %>
          <p class="form-error" role="alert"><%= errors.confirmPassword %></p>
        <% } %>

        <div class="wizard-actions">
          <a class="btn ghost" href="/">Annuler</a>
          <button class="btn" type="submit">Mettre à jour</button>
        </div>
      </form>
    </section>
  </main>

  <script src="/shared/navbar.js" defer></script>
</body>
</html>
